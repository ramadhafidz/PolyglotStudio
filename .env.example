# ============================================================
# Polyglot Studio Environment Configuration Template (.env.example)
#
# PETUNJUK:
# 1. Salin file ini dan ubah namanya menjadi '.env' di root folder proyek:
#      copy .env.example .env
# 2. Isi nilai API Key, Model, dan Path sesuai lingkungan komputer Anda.
# 3. File '.env' Anda otomatis diabaikan oleh git dan aman dari GitHub.
# ============================================================

# --- Konfigurasi AI Localization ---
# Opsi provider yang didukung: openai, anthropic, google
AI_PROVIDER=openai
AI_ENDPOINT=https://api.openai.com/v1
AI_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini
TARGET_LANGUAGE=Indonesian

# --- Path Emulator & Direktori Game ---
# Path direktori load mod Eden (misal: C:\Users\<Nama>\AppData\Roaming\eden\load)
EDEN_LOAD_PATH=

# Path direktori dump RomFS game (misal: E:\Modding\eden\dump)
EDEN_DUMP_PATH=

# Title ID game Nintendo Switch yang sedang dikerjakan (Default: Pokémon Scarlet)
ACTIVE_GAME_ID=0100A3D008C5C000

# Path output Trinity (opsional jika menggunakan RomFS direct worker)
TRINITY_OUTPUT_PATH=
